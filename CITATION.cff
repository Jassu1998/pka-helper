        given-names: Jan H.
    journal: "Journal of Chemical Theory and Computation"
    volume: 7
    start: 525
    year: 2011
    doi: 10.1021/ct100578z
  - type: article
    title: "DelPhiPKa web server: predicting pKa of proteins, RNAs and DNAs"
