diff -ruN a/src/delphiPKa/energy_ckpt.h b/src/delphiPKa/energy_ckpt.h
--- a/src/delphiPKa/energy_ckpt.h	1970-01-01 02:00:00.000000000 +0200
+++ b/src/delphiPKa/energy_ckpt.h	2026-10-18 19:39:11.316075626 +0300
@@ -0,0 +1,141 @@
+//
+//  energy_ckpt.h
+//  DelPhiPKA
+//
+//  Checkpointing of the energy stage.
+//
+//  The energy stage runs two DelPhi focusing calculations (charged and neutral) for every titratable site and is by far the
+//  longest part of a run.  Until all sites are done nothing was written to disk, so an interrupted run (killed job, node
+//  restart, wall-time limit) lost everything.  With "Energy checkpoint directory : <dir>" in run.prm every finished site is
+//  written to <dir>/site_<k>.ckpt at once (to a temporary file that is renamed, so a half-written file can never be read), and a
+//  restarted run skips the sites that already have a valid file.
+//
+//  A site file holds the four per-site energies and the row of the pair-energy table that belongs to the site, exactly the numbers
+//  the MPI gather collects, so a resumed run gives the same energies.txt / pairwise.txt as an uninterrupted one.  It is bound to
+//  the inputs by a fingerprint (structure, charges, radii, dielectric settings, dielectric map contents, build date); a file made
+//  for different inputs is ignored and the site is recomputed.  The files are independent of the number of MPI ranks, so a run
+//  can be resumed with a different -np.  The directory is removed after energies.txt and pairwise.txt have been written.
+//
+
+#ifndef energy_ckpt_h
+#define energy_ckpt_h
+
+#include <string>
+#include <vector>
+#include <fstream>
+#include <cstdio>
+#include <cstdint>
+#include <cstring>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <dirent.h>
+#include <unistd.h>
+
+namespace ckpt {
+
+typedef unsigned long long u64;
+
+static const u64 FNV_OFFSET = 1469598103934665603ULL;
+static const u64 FNV_PRIME  = 1099511628211ULL;
+
+inline u64 fnv(u64 h, const void* data, size_t n)
+{
+    const unsigned char* p = static_cast<const unsigned char*>(data);
+    for(size_t i = 0; i < n; i++) { h ^= p[i]; h *= FNV_PRIME; }
+    return h;
+}
+inline u64 fnv(u64 h, const std::string& s) { u64 n = s.size(); h = fnv(h, &n, sizeof(n)); return fnv(h, s.data(), s.size()); }
+template<class T> inline u64 fnvPod(u64 h, const T& v) { return fnv(h, &v, sizeof(T)); }
+
+// hash of the bytes of a file (0 if it cannot be read); streamed, so a large dielectric map costs well under a second
+inline u64 fileHash(const std::string& path)
+{
+    std::ifstream f(path.c_str(), std::ios::binary);
+    if(!f) return 0;
+    u64 h = FNV_OFFSET;
+    char buf[1 << 16];
+    while(f) { f.read(buf, sizeof(buf)); std::streamsize n = f.gcount(); if(n > 0) h = fnv(h, buf, (size_t)n); }
+    return h;
+}
+
+inline std::string siteFile(const std::string& dir, int k) { return dir + "/site_" + std::to_string(k) + ".ckpt"; }
+
+// create dir and its parents (already existing is fine)
+inline bool makeDirs(const std::string& dir)
+{
+    std::string cur;
+    for(size_t i = 0; i <= dir.size(); i++) {
+        if(i == dir.size() || dir[i] == '/') {
+            if(!cur.empty()) {
+                struct stat st;
+                if(stat(cur.c_str(), &st) != 0) { if(mkdir(cur.c_str(), 0777) != 0 && stat(cur.c_str(), &st) != 0) return false; }
+            }
+        }
+        if(i < dir.size()) cur += dir[i];
+    }
+    return true;
+}
+
+static const char MAGIC[8] = {'D','P','K','A','C','K','0','1'};
+
+// scalars: RxnCrg, RxnNeu, PolarCrg, PolarNeu;  row: 4*N floats
+inline bool save(const std::string& dir, int k, int N, u64 fp, const float scalars[4], const float* row)
+{
+    const std::string fin = siteFile(dir, k), tmp = fin + ".tmp";
+    std::vector<char> buf;
+    auto put = [&buf](const void* p, size_t n) { const char* c = static_cast<const char*>(p); buf.insert(buf.end(), c, c + n); };
+    int32_t n32 = N, k32 = k;
+    put(MAGIC, 8); put(&fp, sizeof(fp)); put(&n32, 4); put(&k32, 4); put(scalars, 4 * sizeof(float)); put(row, (size_t)4 * N * sizeof(float));
+    u64 sum = fnv(FNV_OFFSET, buf.data(), buf.size());
+    put(&sum, sizeof(sum));
+    {
+        std::ofstream f(tmp.c_str(), std::ios::binary | std::ios::trunc);
+        if(!f) return false;
+        f.write(buf.data(), (std::streamsize)buf.size());
+        f.flush();
+        if(!f) { std::remove(tmp.c_str()); return false; }
+    }
+    return std::rename(tmp.c_str(), fin.c_str()) == 0;
+}
+
+// true if a valid file for this site, N and fingerprint exists; fills scalars and row
+inline bool load(const std::string& dir, int k, int N, u64 fp, float scalars[4], float* row)
+{
+    std::ifstream f(siteFile(dir, k).c_str(), std::ios::binary);
+    if(!f) return false;
+    const size_t expect = 8 + sizeof(u64) + 4 + 4 + 4 * sizeof(float) + (size_t)4 * N * sizeof(float) + sizeof(u64);
+    std::vector<char> buf(expect);
+    f.read(buf.data(), (std::streamsize)expect);
+    if((size_t)f.gcount() != expect) return false;
+    char extra; if(f.read(&extra, 1) && f.gcount() > 0) return false;      // longer than expected: not ours
+    if(std::memcmp(buf.data(), MAGIC, 8) != 0) return false;
+    size_t off = 8;
+    u64 fpf; std::memcpy(&fpf, &buf[off], sizeof(fpf)); off += sizeof(fpf);
+    int32_t n32, k32; std::memcpy(&n32, &buf[off], 4); off += 4; std::memcpy(&k32, &buf[off], 4); off += 4;
+    if(fpf != fp || n32 != N || k32 != k) return false;
+    u64 sum; std::memcpy(&sum, &buf[expect - sizeof(u64)], sizeof(sum));
+    if(sum != fnv(FNV_OFFSET, buf.data(), expect - sizeof(u64))) return false;
+    std::memcpy(scalars, &buf[off], 4 * sizeof(float)); off += 4 * sizeof(float);
+    std::memcpy(row, &buf[off], (size_t)4 * N * sizeof(float));
+    return true;
+}
+
+// delete the site files (and temporary files) and the directory if nothing else is in it
+inline bool endsWith(const std::string& s, const std::string& suf) { return s.size() >= suf.size() && s.compare(s.size() - suf.size(), suf.size(), suf) == 0; }
+
+inline void cleanup(const std::string& dir)
+{
+    DIR* d = opendir(dir.c_str());
+    if(!d) return;
+    std::vector<std::string> names;
+    while(struct dirent* e = readdir(d)) names.push_back(e->d_name);
+    closedir(d);
+    for(const std::string& n : names)
+        if(n.compare(0, 5, "site_") == 0 && (endsWith(n, ".ckpt") || endsWith(n, ".ckpt.tmp")))
+            std::remove((dir + "/" + n).c_str());
+    rmdir(dir.c_str());                       // fails harmlessly if the directory holds anything else
+}
+
+} // namespace ckpt
+
+#endif /* energy_ckpt_h */
