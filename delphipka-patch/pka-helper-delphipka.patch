+
+
+/*
+ *  Born transfer energy (kT) of the charged side chain of ionizable residue k from water to the
+ *  BACKGROUND dielectric.  The grid reference (isolated side chain in the same background) cancels the lattice
+ *  self-energy but contains no water reference, so this term restores the water -> membrane transfer penalty.
+ *
+ *  (1) sphere average:  166*q^2 * <integral_R^inf (1/eps_bg(r) - 1/80) / r^2 dr>  over 26 directions (exact for eps(r)).
+ *  (2) planar correction (default): a membrane is a stack of flat layers, not spherical shells, so the sphere average is too
+ *      high within ~5 A of an interface.  The same charge is solved exactly in the laterally averaged layer stack eps(z)
+ *      (reflection-coefficient recursion in 2D Fourier space, validated against the image-charge series, tools/born_benchmark.py):
+ *          dG_planar = 166 * [ (1/e0 - 1/80)/R + int_0^inf dk (u_k(z0) - 1/e0) ]   (medium within +-R of the charge = uniform cavity layer e0)
+ *      and the sphere result is corrected by  f * (sphere_stack - planar_stack),
+ *      f = clamp(sphere_map / sphere_stack, 0, 1)   (f = 0 for charges in pore/lumen water, where the stack does not apply).
+ */
+namespace {
+
+struct BornStack {
+    bool   ready = false;
+    double zlo = 0.0, d = 0.5;
+    std::vector<double> eps;          // layer epsilon (median over the plane), bottom to top
+};
+
+BornStack g_stack;
+
+double stackEps(const BornStack& st, double z)
+{
+    long j = (long)floor((z - st.zlo) / st.d);
+    if(j < 0) j = 0;
+    if(j >= (long)st.eps.size()) j = (long)st.eps.size() - 1;
+    return st.eps[j];
+}
+
+double sphereAverage(const std::function<double(double,double,double)>& epsAt, double cx, double cy, double cz, double R)
+{
+    const double Rmax = 30.0, dr = 0.25, epsW = 80.0;
+    static std::vector<std::array<double,3> > dirs;
+    if(dirs.empty()) {
+        for(int a=-1;a<=1;a++) for(int b=-1;b<=1;b++) for(int c=-1;c<=1;c++) {
+            if(!a && !b && !c) continue;
+            double n = sqrt((double)(a*a+b*b+c*c));
+            dirs.push_back({a/n, b/n, c/n});
+        }
+    }
+    double sum = 0.0;
+    for(const auto& dd : dirs) {
+        double acc = 0.0;
+        for(double r = R + 0.5*dr; r < Rmax; r += dr) {
+            double e = epsAt(cx+dd[0]*r, cy+dd[1]*r, cz+dd[2]*r);
+            if(e < 1.0) e = epsW;
+            acc += (1.0/e - 1.0/epsW) / (r*r) * dr;
+        }
+        sum += acc;
+    }
+    return 166.0 * sum / dirs.size();     // kcal/mol, q = 1
+}
+
+double planarTransfer(const BornStack& st, double z0, double R)
+{
+    const double epsW = 80.0;
+    const int Lfull = (int)st.eps.size();
+    const double d = st.d;
+    
+    double inv = 0.0;                                   // cavity epsilon: harmonic mean over [z0-R, z0+R]
+    for(int i = 0; i < 41; i++) inv += 1.0 / stackEps(st, z0 - R + 2.0*R*i/40.0);
+    const double e0 = 41.0 / inv;
+    
+    // the medium within +-R of the charge becomes ONE uniform cavity layer (no boundary closer than R)
+    long jlo = (long)floor((z0 - R - st.zlo) / d);
+    long jhi = (long)ceil ((z0 + R - st.zlo) / d);
+    if(jlo < 0) jlo = 0;
+    if(jlo > Lfull) jlo = Lfull;
+    if(jhi < 0) jhi = 0;
+    if(jhi > Lfull) jhi = Lfull;
+    std::vector<double> eps;
+    eps.reserve(Lfull + 1);
+    for(long j = 0; j < jlo; j++) eps.push_back(st.eps[j]);
+    const int s = (int)eps.size();
+    eps.push_back(e0);
+    for(long j = jhi; j < Lfull; j++) eps.push_back(st.eps[j]);
+    const int L = (int)eps.size();
+    const double aB = z0 - (st.zlo + jlo*d), aT = (st.zlo + jhi*d) - z0;     // distances to the cavity-layer edges, >= R
+    
+    std::vector<double> rUp(L > 1 ? L-1 : 0);
+    for(int j = 0; j < L-1; j++) rUp[j] = (eps[j] - eps[j+1]) / (eps[j] + eps[j+1]);
+    
+    const int nk = 600;
+    const double kmin = 1e-4, kmax = 10.0, dl = log(kmax/kmin)/(nk-1);
+    std::vector<double> Rt(L), Rb(L);
+    double integ = 0.0;
+    for(int ik = 0; ik < nk; ik++) {
+        const double k = kmin * exp(dl*ik);
+        const double E = exp(-2.0*k*d);
+        Rt[L-1] = 0.0;
+        for(int j = L-2; j >= 0; j--) { double x = Rt[j+1]*E; Rt[j] = (rUp[j] + x) / (1.0 + rUp[j]*x); }
+        Rb[0] = 0.0;
+        for(int j = 1; j < L; j++)  { double x = Rb[j-1]*E; Rb[j] = (-rUp[j-1] + x) / (1.0 - rUp[j-1]*x); }
+        const double et = exp(-2.0*k*aT), eb = exp(-2.0*k*aB);
+        const double rt = Rt[s], rb = Rb[s];
+        const double rf = (rt*et + rb*eb + 2.0*rt*rb*et*eb) / (1.0 - rt*rb*et*eb);
+        const double f = rf / e0;
+        const double w = (ik == 0 || ik == nk-1) ? 0.5 : 1.0;      // trapezoid in ln k
+        integ += w * f * k * dl;
+    }
+    return 166.0 * ((1.0/e0 - 1.0/epsW)/R + integ);
+}
+
+} // namespace
+
+double CEnergy::bornTransfer(int k) const
+{
+    if(!(bUseCustomEps && bCustomEpsBackground && bCustomEpsBorn)) return 0.0;
+    
+    double c[3] = {0,0,0}, w = 0.0;
+    for(size_t j=0; j<vecIonRes[k].size(); j++) {
+        const PDBFORM& a = newPDB[vecIonRes[k][j]];
+        double q = fabs(a.fCharge);
+        if(q < 0.2) continue;
+        c[0] += q*a.coord.X; c[1] += q*a.coord.Y; c[2] += q*a.coord.Z; w += q;
+    }
+    if(w <= 0) return 0.0;
+    for(int i=0;i<3;i++) c[i] /= w;
+    
+    const double R = fBornRadius;
+    const double epsW = 80.0;
+    
+    auto epsMap = [&](double x, double y, double z) -> double {
+        double e;
+        if(!customEps.sample(x, y, z, e)) e = epsW;
+        return e;
+    };
+    double kcal = sphereAverage(epsMap, c[0], c[1], c[2], R);
+    
+    if(bBornPlanar) {
+        const bool curved = !strDistMapFile.empty();
+        if(!g_stack.ready) {
+            if(!strStackFile.empty()) {       // profile of the undisturbed membrane written by membrane_pka.py: independent of the map box
+                std::ifstream sf(strStackFile.c_str());
+                if(!sf) { cout << "[ERROR] cannot open Custom dielectric stack file " << strStackFile << endl; exit(1); }
+                std::vector<double> xs, es; double xv, ev; string line;
+                while(std::getline(sf, line)) { if(line.empty() || line[0]=='#') continue; std::istringstream ls(line); if(ls >> xv >> ev) { xs.push_back(xv); es.push_back(ev); } }
+                if(xs.size() < 3) { cout << "[ERROR] Custom dielectric stack file needs >= 3 lines 'x eps'" << endl; exit(1); }
+                g_stack.d   = (xs.back() - xs.front()) / (xs.size() - 1);
+                g_stack.zlo = xs.front() - 0.5*g_stack.d;
+                g_stack.eps.assign(es.begin(), es.end());
+            } else if(curved) {
+                // curved membrane: eps as a function of the signed distance d to the mid-surface = median of the map over the voxels
+                // in each d-bin (bin width = grid spacing, so a flat membrane gives the same stack as the planar branch)
+                const double bw = customEps.delta[0];
+                float dmin = distMap.data[0], dmax = distMap.data[0];
+                for(float v : distMap.data) { if(v < dmin) dmin = v; if(v > dmax) dmax = v; }
+                const long nb = (long)ceil((dmax - dmin) / bw) + 1;
+                g_stack.zlo = dmin - 0.5*bw;
+                g_stack.d   = bw;
+                g_stack.eps.assign(nb, epsW);
+                std::vector<std::vector<float> > bins(nb);
+                for(size_t i = 0; i < distMap.data.size(); i++) {
+                    long b = (long)floor((distMap.data[i] - g_stack.zlo) / bw);
+                    if(b < 0) b = 0;
+                    if(b >= nb) b = nb - 1;
+                    bins[b].push_back(customEps.data[i]);
+                }
+                for(long b = 0; b < nb; b++) if(!bins[b].empty()) {
+                    std::nth_element(bins[b].begin(), bins[b].begin()+bins[b].size()/2, bins[b].end());
+                    g_stack.eps[b] = bins[b][bins[b].size()/2];
+                }
+            } else {                      // laterally averaged (median) eps(z) of the map
+            const int ax = iMembraneAxis, a1 = (ax+1)%3, a2 = (ax+2)%3;
+            const int nz = customEps.n[ax];
+            g_stack.zlo = customEps.origin[ax] - 0.5*customEps.delta[ax];
+            g_stack.d   = customEps.delta[ax];
+            g_stack.eps.assign(nz, epsW);
+            long stride[3] = {(long)customEps.n[1]*customEps.n[2], (long)customEps.n[2], 1};
+            std::vector<float> plane;
+            for(int iz = 0; iz < nz; iz++) {
+                plane.clear();
+                for(int i1 = 0; i1 < customEps.n[a1]; i1++)
+                    for(int i2 = 0; i2 < customEps.n[a2]; i2++)
+                        plane.push_back(customEps.data[iz*stride[ax] + i1*stride[a1] + i2*stride[a2]]);
+                std::nth_element(plane.begin(), plane.begin()+plane.size()/2, plane.end());
+                g_stack.eps[iz] = plane[plane.size()/2];
+            }
+            }
+            g_stack.ready = true;
+        }
+        auto distAt = [&](double x, double y, double z) -> double {
+            if(!curved) { const double p[3] = {x, y, z}; return p[iMembraneAxis]; }
+            double dv = 0.0;
+            distMap.sample(x, y, z, dv);
+            return dv;
+        };
+        const double z0 = distAt(c[0], c[1], c[2]);
+        auto epsStack = [&](double x, double y, double z) -> double {
+            return stackEps(g_stack, distAt(x, y, z));
+        };
+        const double sphStack = sphereAverage(epsStack, c[0], c[1], c[2], R);
+        if(sphStack > 1e-6) {
+            const double planar = planarTransfer(g_stack, z0, R);
+            double f = kcal / sphStack;
+            if(f < 0.0) f = 0.0;
+            if(f > 1.0) f = 1.0;
+            kcal -= f * (sphStack - planar);
+        }
+    }
+    return kcal / 0.59;
+}
