+        V.push_back(r0);
+        g.assign(maxIt+2, 0.0); g[0] = beta;
+        for (int j = 0; j < maxIt; j++)
+        {
+            cyc = j+1;
+            Z.push_back(vector<double>());
+            const double t0 = mgNow();
+            precond(V[j], Z[j]);
+            const double t1 = mgNow();
+            vector<double> w;
+            matvec(Z[j], w);
+            const double t2 = mgNow(); g_tp += t1-t0; g_tm += t2-t1;
+            vector<double> h(j+2, 0.0);
+            for (int i = 0; i <= j; i++)
+            {
+                double d = 0.0; const vector<double>& vi = V[i];
+                for (size_t k = 0; k < n3; k++) d += w[k]*vi[k];
+                h[i] = d;
+                for (size_t k = 0; k < n3; k++) w[k] -= d*vi[k];
+            }
+            double nw = 0.0; for (size_t k = 0; k < n3; k++) nw += w[k]*w[k];
+            nw = sqrt(nw); h[j+1] = nw;
+            for (int i = 0; i < j; i++) { const double t = cs[i]*h[i] + sn[i]*h[i+1]; h[i+1] = -sn[i]*h[i] + cs[i]*h[i+1]; h[i] = t; }
+            const double rr = sqrt(h[j]*h[j] + h[j+1]*h[j+1]);
+            if (!(rr > 0.0)) break;
+            cs.push_back(h[j]/rr); sn.push_back(h[j+1]/rr);
+            h[j] = rr; h[j+1] = 0.0;
+            g[j+1] = -sn[j]*g[j]; g[j] = cs[j]*g[j];
+            H.push_back(h);
+            // y by back substitution, delta = sum y_i Z_i
+            vector<double> y(j+1, 0.0);
+            for (int i = j; i >= 0; i--)
+            {
+                double t = g[i];
+                for (int k = i+1; k <= j; k++) t -= H[k][i]*y[k];
+                y[i] = t/H[i][i];
+            }
+            const double t3 = mgNow(); g_to += t3-t2;
+            if (fabs(g[j+1]) < 0.05)       // only form the update (an O(j N^3) cost) once the residual is small
+            {
+                delta.assign(n3, 0.0);
+                for (int i = 0; i <= j; i++) { const vector<double>& zi = Z[i]; const double yi = y[i]; for (size_t k = 0; k < n3; k++) delta[k] += yi*zi[k]; }
+                corr = 0.0;
+                if (haveDeltaPrev) for (size_t k = 0; k < n3; k++) corr = max(corr, fabs(delta[k]-deltaPrev[k]));
+                else corr = 1e30;
+                haveDeltaPrev = true;
+            }
+            else { haveDeltaPrev = false; corr = 1e30; }
+            g_td += mgNow()-t3;
+            if (getenv("PKA_MG_TRACE")) fprintf(stderr, "  it %d resid %g change %g\n", j+1, fabs(g[j+1]), corr);
+            if (!(corr == corr) || (corr > 1.0e6 && corr < 1.0e29)) break;
+            if (corr < tolC) { ok = true; break; }
+            if (haveDeltaPrev) deltaPrev = delta;
+            if (!(nw > 0.0)) { ok = true; break; }
+            for (size_t k = 0; k < n3; k++) w[k] /= nw;
+            V.push_back(w);
+        }
+        if (ok) for (size_t k = 0; k < n3; k++) phi[k] += delta[k];
+    }
+    else ok = true;
+
+    if (!ok)
+    {
+        if (getenv("PKA_MG_DEBUG")) fprintf(stderr, "MG N=%d FAIL cycles=%d corr=%g\n", N, cyc, corr);
+        cout << "  multigrid: no convergence after " << cyc << " cycles (last correction " << scientific << corr << "), using SOR" << endl;
+        return false;
+    }
+    if (getenv("PKA_MG_DEBUG")) fprintf(stderr, "MG N=%d ok cycles=%d corr=%g levels=%d precond=%.0f matvec=%.0f ortho=%.0f delta=%.0f setup=%.1fms (stencil %.1f, eps %.1f, coarsen %.1f) cycles=%.1fms\n", N, cyc, corr, (int)lv.size(), 1e3*g_tp, 1e3*g_tm, 1e3*g_to, 1e3*g_td, 1e3*(tm1-tm0), 1e3*(tmA-tm0), 1e3*(g_tmB-tmA), 1e3*(tm1-g_tmB), 1e3*(mgNow()-tm1));
+    cout << "  multigrid: converged in " << cyc << " cycles (last correction " << scientific << corr << ", " << lv.size() << " levels)" << endl;
+    for (size_t i = 0; i < n3; i++) prgfPhiMap[i] = phi[i];
+    return true;
+}
