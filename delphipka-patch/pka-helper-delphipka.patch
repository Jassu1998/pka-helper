diff -ruN a/src/delphi/misc/misc_customeps.cpp b/src/delphi/misc/misc_customeps.cpp
--- a/src/delphi/misc/misc_customeps.cpp	1970-01-01 02:00:00.000000000 +0200
+++ b/src/delphi/misc/misc_customeps.cpp	2026-10-18 19:39:09.604125460 +0300
@@ -0,0 +1,238 @@
+/*
+ * misc_customeps.cpp - see misc_customeps.h
+ */
+
+#include "misc_customeps.h"
+#include <fstream>
+#include <sstream>
+#include <stdexcept>
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <iterator>
+
+const SCustomEps* g_pCustomEps = nullptr;
+
+bool SCustomEps::sample(double x, double y, double z, double& value) const
+{
+    double fx = (x - origin[0]) / delta[0];
+    double fy = (y - origin[1]) / delta[1];
+    double fz = (z - origin[2]) / delta[2];
+
+    // tiny tolerance so points sitting exactly on the last plane are not rejected
+    const double tol = 1e-9;
+    if (!extendOutside &&
+        (fx < -tol || fy < -tol || fz < -tol ||
+         fx > n[0] - 1 + tol || fy > n[1] - 1 + tol || fz > n[2] - 1 + tol)) return false;
+
+    fx = std::min(std::max(fx, 0.0), double(n[0] - 1));
+    fy = std::min(std::max(fy, 0.0), double(n[1] - 1));
+    fz = std::min(std::max(fz, 0.0), double(n[2] - 1));
+
+    int i0 = std::min(int(fx), std::max(n[0] - 2, 0)), i1 = std::min(i0 + 1, n[0] - 1);
+    int j0 = std::min(int(fy), std::max(n[1] - 2, 0)), j1 = std::min(j0 + 1, n[1] - 1);
+    int k0 = std::min(int(fz), std::max(n[2] - 2, 0)), k1 = std::min(k0 + 1, n[2] - 1);
+    double tx = fx - i0, ty = fy - j0, tz = fz - k0;
+
+    auto at = [&](int i, int j, int k) -> double {
+        return data[((size_t)i * n[1] + j) * n[2] + k];
+    };
+
+    double c00 = at(i0,j0,k0)*(1-tx) + at(i1,j0,k0)*tx;
+    double c10 = at(i0,j1,k0)*(1-tx) + at(i1,j1,k0)*tx;
+    double c01 = at(i0,j0,k1)*(1-tx) + at(i1,j0,k1)*tx;
+    double c11 = at(i0,j1,k1)*(1-tx) + at(i1,j1,k1)*tx;
+    double c0  = c00*(1-ty) + c10*ty;
+    double c1  = c01*(1-ty) + c11*ty;
+    value = c0*(1-tz) + c1*tz;
+    return true;
+}
+
+double SCustomEps::epsilon(double x, double y, double z, double epsOut) const
+{
+    double v;
+    if (!sample(x, y, z, v)) return epsOut;
+    return v;
+}
+
+double SCustomEps::density(double x, double y, double z, double epsIn, double epsOut) const
+{
+    double v;
+    if (!sample(x, y, z, v)) return 0.0;               // outside the map: bulk solvent
+
+    double f;
+    if (isFraction) f = v;
+    else            f = (epsOut - v) / (epsOut - epsIn); // invert eps = f*epsIn + (1-f)*epsOut
+    return std::min(std::max(f, 0.0), 1.0);
+}
+
+void loadCustomEpsDX(const std::string& file, bool isFraction, SCustomEps& out)
+{
+    std::ifstream in(file.c_str());
+    if (!in) throw std::runtime_error("cannot open custom dielectric map '" + file + "'");
+
+    out.isFraction = isFraction;
+    out.data.clear();
+    bool haveCounts = false, haveOrigin = false;
+    int  nDelta = 0;
+    double delta[3][3] = {{0,0,0},{0,0,0},{0,0,0}};
+    size_t items = 0;
+    bool dataFollows = false;
+    std::string line;
+
+    while (!dataFollows && std::getline(in, line))
+    {
+        if (line.empty() || line[0] == '#') continue;
+        std::istringstream ss(line);
+        std::string w1;
+        ss >> w1;
+
+        if (w1 == "object")
+        {
+            // "object 1 class gridpositions counts nx ny nz"
+            // "object 3 class array type double rank 0 items N [data follows]"
+            std::string tok;
+            std::vector<std::string> t;
+            while (ss >> tok) t.push_back(tok);
+            for (size_t a = 0; a < t.size(); ++a)
+            {
+                if (t[a] == "counts" && a + 3 < t.size())
+                {
+                    out.n[0] = std::stoi(t[a+1]); out.n[1] = std::stoi(t[a+2]); out.n[2] = std::stoi(t[a+3]);
+                    haveCounts = true;
+                }
+                if (t[a] == "items" && a + 1 < t.size()) items = (size_t)std::stoull(t[a+1]);
+                if (t[a] == "data" && a + 1 < t.size() && t[a+1] == "follows") dataFollows = true;
+            }
+        }
+        else if (w1 == "origin")
+        {
+            ss >> out.origin[0] >> out.origin[1] >> out.origin[2];
+            haveOrigin = true;
+        }
+        else if (w1 == "delta")
+        {
+            if (nDelta >= 3) throw std::runtime_error("custom dielectric map: more than 3 'delta' lines");
+            ss >> delta[nDelta][0] >> delta[nDelta][1] >> delta[nDelta][2];
+            ++nDelta;
+        }
+    }
+
+    if (!haveCounts || !haveOrigin || nDelta != 3 || !dataFollows)
+        throw std::runtime_error("custom dielectric map '" + file + "' is not a valid OpenDX scalar grid "
+                                 "(need gridpositions counts / origin / 3x delta / 'data follows')");
+
+    for (int a = 0; a < 3; ++a)
+    {
+        // axis-aligned only: delta[a] must have its only non-zero component on axis a
+        for (int b = 0; b < 3; ++b)
+            if (b != a && std::fabs(delta[a][b]) > 1e-12)
+                throw std::runtime_error("custom dielectric map: rotated/skewed grids are not supported");
+        out.delta[a] = delta[a][a];
+        if (out.delta[a] <= 0.0) throw std::runtime_error("custom dielectric map: grid spacing must be positive");
+        if (out.n[a] < 2)        throw std::runtime_error("custom dielectric map: need at least 2 points per axis");
+    }
+
+    size_t total = (size_t)out.n[0] * out.n[1] * out.n[2];
+    if (items != 0 && items != total)
+        throw std::runtime_error("custom dielectric map: 'items' does not match counts");
+
+    out.data.reserve(total);
+    double v;
+    while (out.data.size() < total && in >> v) out.data.push_back((float)v);
+
+    if (out.data.size() != total)
+        throw std::runtime_error("custom dielectric map '" + file + "': expected " + std::to_string(total) +
+                                 " values, found " + std::to_string(out.data.size()));
+}
+
+
+void loadCustomEpsCube(const std::string& file, bool isFraction, SCustomEps& out)
+{
+    const double BOHR = 0.529177210903;   // Angstrom per Bohr
+
+    std::ifstream in(file.c_str(), std::ios::binary);
+    if (!in) throw std::runtime_error("cannot open custom dielectric map '" + file + "'");
+
+    out.isFraction = isFraction;
+    out.data.clear();
+
+    std::string line, l1, l2;
+    if (!std::getline(in, l1) || !std::getline(in, l2))
+        throw std::runtime_error("custom dielectric map '" + file + "': truncated cube header");
+
+    long natoms = 0;
+    double org[3];
+    {
+        if (!std::getline(in, line)) throw std::runtime_error("cube header: missing atom/origin line");
+        std::istringstream ss(line);
+        if (!(ss >> natoms >> org[0] >> org[1] >> org[2]))
+            throw std::runtime_error("cube header: cannot read 'natoms ox oy oz' (line 3)");
+        if (natoms < 0) throw std::runtime_error("cube files with orbital data (negative atom count) are not supported");
+    }
+
+    long   cnt[3];
+    double vox[3][3];
+    for (int a = 0; a < 3; ++a)
+    {
+        if (!std::getline(in, line)) throw std::runtime_error("cube header: missing voxel line");
+        std::istringstream ss(line);
+        if (!(ss >> cnt[a] >> vox[a][0] >> vox[a][1] >> vox[a][2]))
+            throw std::runtime_error("cube header: cannot read voxel line " + std::to_string(a + 1));
+    }
+
+    bool allBohr = cnt[0] > 0 && cnt[1] > 0 && cnt[2] > 0;
+    bool allAng  = cnt[0] < 0 && cnt[1] < 0 && cnt[2] < 0;
+    if (!allBohr && !allAng) throw std::runtime_error("cube header: mixed Bohr/Angstrom voxel counts");
+    const double unit = allBohr ? BOHR : 1.0;
+
+    for (int a = 0; a < 3; ++a)
+    {
+        for (int b = 0; b < 3; ++b)
+            if (b != a && std::fabs(vox[a][b]) > 1e-9)
+                throw std::runtime_error("custom dielectric map: rotated/skewed cube grids are not supported");
+        out.n[a]      = (int)std::labs(cnt[a]);
+        out.origin[a] = org[a] * unit;
+        out.delta[a]  = vox[a][a] * unit;
+        if (out.delta[a] <= 0.0) throw std::runtime_error("custom dielectric map: grid spacing must be positive");
+        if (out.n[a] < 2)        throw std::runtime_error("custom dielectric map: need at least 2 points per axis");
+    }
+
+    for (long i = 0; i < natoms; ++i)             // atom records: Z charge x y z (ignored)
+        if (!std::getline(in, line)) throw std::runtime_error("cube header: truncated atom list");
+
+    const size_t total = (size_t)out.n[0] * out.n[1] * out.n[2];
+    std::string rest((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+
+    out.data.reserve(total);
+    const char* p = rest.c_str();
+    const char* end = p + rest.size();
+    while (out.data.size() < total)
+    {
+        char* q;
+        double v = std::strtod(p, &q);
+        if (q == p) break;                        // no more numbers
+        out.data.push_back((float)v);
+        p = q;
+        if (p >= end) break;
+    }
+
+    if (out.data.size() != total)
+        throw std::runtime_error("custom dielectric map '" + file + "': expected " + std::to_string(total) +
+                                 " values, found " + std::to_string(out.data.size()));
+}
+
+void loadCustomEps(const std::string& file, bool isFraction, SCustomEps& out)
+{
+    std::ifstream in(file.c_str());
+    if (!in) throw std::runtime_error("cannot open custom dielectric map '" + file + "'");
+
+    std::string line;
+    bool isDX = false;
+    for (int i = 0; i < 200 && std::getline(in, line); ++i)
+        if (line.compare(0, 6, "object") == 0) { isDX = true; break; }
+    in.close();
+
+    if (isDX) loadCustomEpsDX(file, isFraction, out);
+    else      loadCustomEpsCube(file, isFraction, out);
+}
diff -ruN a/src/delphi/misc/misc_customeps.h b/src/delphi/misc/misc_customeps.h
--- a/src/delphi/misc/misc_customeps.h	1970-01-01 02:00:00.000000000 +0200
+++ b/src/delphi/misc/misc_customeps.h	2026-10-18 19:39:09.604085155 +0300
@@ -0,0 +1,64 @@
+/*
+ * misc_customeps.h
+ *
+ * User-supplied dielectric map support (added to DelPhiPKa).
+ *
+ * The map is read once from an OpenDX or Gaussian-cube scalar-field file (regular, axis-aligned grid,
+ * same coordinate frame as the input PDB; DX in Angstrom, cube in Bohr unless the counts are negative). Each DelPhi run (base grid and
+ * focusing grids, different scale/centre every time) samples the map by trilinear
+ * interpolation at the positions where DelPhi needs the dielectric (mid-points of grid edges).
+ *
+ * Two interpretations of the stored values:
+ *   EPS      : values are the relative dielectric constant epsilon itself (e.g. 2 ... 80)
+ *   FRACTION : values are a "protein density" in [0,1] (1 = fully internal/indi, 0 = bulk/exdi),
+ *              i.e. exactly the quantity the built-in Gaussian model produces.
+ * EPS maps are used as the dielectric constant itself (any value, also below the internal dielectric,
+ * e.g. a membrane core); FRACTION maps are the Gaussian-model density.
+ * Outside the box covered by the map the medium is treated as bulk solvent, or, with extendOutside,
+ * the value of the nearest map edge is extended (useful for membrane slabs, see tools/membrane_to_dx.py).
+ */
+
+#ifndef MISC_CUSTOMEPS_H_
+#define MISC_CUSTOMEPS_H_
+
+#include <string>
+#include <vector>
+
+struct SCustomEps
+{
+    int    n[3];               // number of points along x, y, z
+    double origin[3];          // coordinates of point (0,0,0)
+    double delta[3];           // spacing along x, y, z (must be > 0)
+    bool   isFraction;         // false: values are epsilon, true: values are density in [0,1]
+    bool   isBackground = false;  // true: map = epsilon of everything except the protein; the protein Gaussian density is computed by DelPhi
+    bool   extendOutside = false; // false: outside the map = bulk water; true: nearest edge value is extended
+    std::vector<double> waterXYZ;     // BACKGROUND maps: x,y,z triples of crystal-water pockets (continuum water carved out of the protein)
+    double waterRadius = 1.6;         // pocket radius, A
+    double waterEps    = 80.0;        // dielectric inside the pockets
+    std::vector<float> data;   // data[(i*ny + j)*nz + k], x slowest, z fastest (DX order)
+
+    /// Trilinear interpolation at (x,y,z) in Angstrom. Returns false if outside the map.
+    bool sample(double x, double y, double z, double& value) const;
+
+    /// Dielectric constant at (x,y,z) for an EPS map (epsOut outside the map unless extendOutside).
+    double epsilon(double x, double y, double z, double epsOut) const;
+
+    /// Density in [0,1] at (x,y,z) for the given dielectrics (0 outside the map).
+    double density(double x, double y, double z, double epsIn, double epsOut) const;
+};
+
+/// Read an OpenDX file. Throws std::runtime_error with a readable message on failure.
+void loadCustomEpsDX(const std::string& file, bool isFraction, SCustomEps& out);
+
+/// Read a Gaussian/DelPhi "cube" text file (one value per grid node, x slowest / z fastest).
+/// Standard cube units: voxel counts > 0 mean Bohr, < 0 mean Angstrom; the first two lines are free text.
+void loadCustomEpsCube(const std::string& file, bool isFraction, SCustomEps& out);
+
+/// Pick the reader from the file content (OpenDX has "object ..." header lines, otherwise cube).
+void loadCustomEps(const std::string& file, bool isFraction, SCustomEps& out);
+
+/// Map currently used by setGaussian(). nullptr means: use the built-in Gaussian model.
+/// Set by runDelphi() from SPrime::pCustomEps before every DelPhi run.
+extern const SCustomEps* g_pCustomEps;
+
+#endif // MISC_CUSTOMEPS_H_
