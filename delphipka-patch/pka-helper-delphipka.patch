+/*
+ *  Fingerprint of everything the energy tables depend on: structure and charges, radii, dielectric settings, the dielectric map
+ *  file, the program binary.  A checkpoint written under another fingerprint is ignored (see energy_ckpt.h).
+ */
+unsigned long long CEnergy :: ckptFingerprint(int N) const
+{
+    using namespace ckpt;
+    u64 h = FNV_OFFSET;
+    h = fnvPod(h, N);
+    h = fnvPod(h, (u64)newPDB.size());
+    for(const PDBFORM& a : newPDB) {
+        h = fnv(h, a.res_name); h = fnv(h, a.atom_name); h = fnv(h, a.chain_id); h = fnv(h, a.conf);
+        h = fnvPod(h, a.res_num);
+        const double c[3] = { a.coord.X, a.coord.Y, a.coord.Z };
+        h = fnv(h, c, sizeof(c));
+        h = fnvPod(h, a.fCharge); h = fnvPod(h, a.fRidus); h = fnvPod(h, a.bIonizable); h = fnvPod(h, a.bCharged);
+    }
+    for(const vector<int>& r : vecIonRes) { h = fnvPod(h, (u64)r.size()); for(int v : r) h = fnvPod(h, v); }
+    const float salt = (float)fSalt;
+    { extern float g_baseFill; if(g_baseFill != 70.0f) h = fnvPod(h, g_baseFill); }
+    { extern bool g_skipArgLys; if(g_skipArgLys) h = fnvPod(h, (int)7); }
+    { extern float g_specBase, g_specFocus; if(g_specBase != 0.8f || g_specFocus != 0.8f) { h = fnvPod(h, g_specBase); h = fnvPod(h, g_specFocus); } }
+    h = fnvPod(h, indi); h = fnvPod(h, exdi); h = fnvPod(h, prbrad); h = fnvPod(h, ionrad); h = fnvPod(h, maxc); h = fnvPod(h, salt);
+    h = fnvPod(h, iGaussian); h = fnvPod(h, fSigma); h = fnvPod(h, fSrfcut);
+    h = fnv(h, customEpsFile);
+    h = fnv(h, strDistMapFile); h = fnv(h, strStackFile);
+    if(!strStackFile.empty()) h = fnvPod(h, fileHash(strStackFile));
+    h = fnv(h, strOnlyChains);
+    h = fnv(h, strWaterFile); h = fnvPod(h, fWaterRadius); h = fnvPod(h, fWaterEps);
+    if(!strWaterFile.empty()) h = fnvPod(h, fileHash(strWaterFile));
+    if(!strDistMapFile.empty()) h = fnvPod(h, fileHash(strDistMapFile));
+    if(!customEpsFile.empty()) h = fnvPod(h, fileHash(customEpsFile));
+    h = fnvPod(h, bCustomEpsFraction); h = fnvPod(h, bCustomEpsBackground); h = fnvPod(h, bCustomEpsBorn); h = fnvPod(h, bCustomEpsExtend);
+    h = fnvPod(h, fBornRadius); h = fnvPod(h, bBornPlanar); h = fnvPod(h, iMembraneAxis);
+    h = fnvPod(h, bHETATMinPQR);
+    for(const string& t : strHETATM) h = fnv(h, t);
+    for(float q : vecCrgHETATM) h = fnvPod(h, q);
+    // order-independent hashes of the charge and radius tables
+    u64 mix = 0;
+    for(const auto& kv : crgmap) { u64 e = fnv(FNV_OFFSET, kv.first); e = fnvPod(e, kv.second); mix ^= e; }
+    h = fnvPod(h, mix); mix = 0;
+    for(const auto& kv : sizmap) { u64 e = fnv(FNV_OFFSET, kv.first); e = fnvPod(e, kv.second); mix ^= e; }
+    h = fnvPod(h, mix);
+    h = fnvPod(h, fileHash("/proc/self/exe"));                   // any rebuild of the program invalidates old checkpoints
+    return h;
+}
