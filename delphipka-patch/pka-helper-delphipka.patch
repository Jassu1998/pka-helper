diff -ruN a/src/delphi/solver/solver_fastSOR_mg.cpp b/src/delphi/solver/solver_fastSOR_mg.cpp
--- a/src/delphi/solver/solver_fastSOR_mg.cpp	1970-01-01 02:00:00.000000000 +0200
+++ b/src/delphi/solver/solver_fastSOR_mg.cpp	2026-10-19 22:44:56.666447385 +0300
@@ -0,0 +1,504 @@
+/*
+ * solver_fastSOR_mg.cpp
+ *
+ * Geometric multigrid for the linear Poisson-Boltzmann system that itit() otherwise solves with red-black SOR.
+ *
+ * The fixed point of the SOR iteration is phi(g) = sum_k a(g,k) phi(g+d_k) + q(g) on the interior nodes (the faces of the box
+ * hold fixed boundary values). The coefficients a are rebuilt here from exactly the arrays the SOR sweeps read (salt map,
+ * dielectric-boundary rows, charge list), so the fine-level smoother and residual are those of the existing solver and the
+ * converged answer is the same linear system's solution, not a re-discretisation.
+ *
+ * The coarse levels only have to give a good correction. They use the symmetric finite-volume operator
+ *       K phi = sum_edges g (phi_g - phi_k) + m phi
+ * built from the Gaussian edge dielectrics (g = eps) and the Debye mask (m = debfct inside the ion-accessible region), coarsened
+ * by series/parallel averaging of the edge conductances, with trilinear prolongation and its transpose as restriction.
+ * The fine residual is mapped to this scaling with D = diag(K).
+ *
+ * Used only for focusing (boundary values from the previous grid) on grids with an odd number of points. If the cycles do not
+ * converge, mgSolve() returns false and the caller falls back to SOR from the original initial guess.
+ * EXPERIMENTAL, off by default: PKA_MG=1 switches it on (PKA_MG_ALL=1 also tries the base grid). It converges, but with this
+ * discretisation it is not faster than the tuned SOR (see LAB_NOTEBOOK.md), so it is kept for reference only.
+ */
+
+#include "solver_fastSOR.h"
+#include <cstdlib>
+#include <cmath>
+#include <cstdio>
+#include <ctime>
+static double g_tmB = 0.0, g_tp = 0.0, g_tm = 0.0, g_to = 0.0, g_td = 0.0;
+static inline double mgNow(){ struct timespec t; clock_gettime(CLOCK_MONOTONIC,&t); return t.tv_sec+1e-9*t.tv_nsec; }
+
+namespace
+{
+
+struct MGLevel
+{
+    int n;
+    vector<double> gx, gy, gz;   // edge conductances (node -> node+1 along x, y, z), indexed by the lower node
+    vector<double> m;            // mass (Debye) term per node
+    vector<double> kd;           // diagonal of K
+    vector<double> e, b;         // correction and right-hand side (levels >= 1)
+};
+
+inline void build_kd(MGLevel& L)
+{
+    const int n = L.n, nn = n*n;
+    L.kd.assign((size_t)n*nn, 1.0);
+    for (int z = 1; z < n-1; z++)
+        for (int y = 1; y < n-1; y++)
+        {
+            size_t i = ((size_t)z*n + y)*n;
+            for (int x = 1; x < n-1; x++)
+            {
+                const size_t p = i + x;
+                L.kd[p] = L.gx[p] + L.gx[p-1] + L.gy[p] + L.gy[p-n] + L.gz[p] + L.gz[p-nn] + L.m[p];
+            }
+        }
+}
+
+// one red-black Gauss-Seidel sweep of K e = b on a coarse level
+inline void sweepCoarse(MGLevel& L)
+{
+    const int n = L.n, nn = n*n;
+    double* e = &L.e[0];
+    const double *b = &L.b[0], *gx = &L.gx[0], *gy = &L.gy[0], *gz = &L.gz[0], *kd = &L.kd[0];
+    for (int color = 0; color < 2; color++)
+        for (int z = 1; z < n-1; z++)
+            for (int y = 1; y < n-1; y++)
+            {
+                const size_t row = ((size_t)z*n + y)*n;
+                int x = (((row + 1) & 1) == (size_t)color) ? 1 : 2;
+                for (; x < n-1; x += 2)
+                {
+                    const size_t p = row + x;
+                    e[p] = (b[p] + gx[p]*e[p+1] + gx[p-1]*e[p-1] + gy[p]*e[p+n] + gy[p-n]*e[p-n] + gz[p]*e[p+nn] + gz[p-nn]*e[p-nn]) / kd[p];
+                }
+            }
+}
+
+// r = b - K e on a coarse level (interior nodes), stored in r
+inline void residualCoarse(const MGLevel& L, vector<double>& r)
+{
+    const int n = L.n, nn = n*n;
+    r.assign((size_t)n*nn, 0.0);
+    const double *e = &L.e[0], *b = &L.b[0], *gx = &L.gx[0], *gy = &L.gy[0], *gz = &L.gz[0], *kd = &L.kd[0];
+    for (int z = 1; z < n-1; z++)
+        for (int y = 1; y < n-1; y++)
+        {
+            const size_t row = ((size_t)z*n + y)*n;
+            for (int x = 1; x < n-1; x++)
+            {
+                const size_t p = row + x;
+                r[p] = b[p] - kd[p]*e[p] + gx[p]*e[p+1] + gx[p-1]*e[p-1] + gy[p]*e[p+n] + gy[p-n]*e[p-n] + gz[p]*e[p+nn] + gz[p-nn]*e[p-nn];
+            }
+        }
+}
+
+// coarse level from the fine one: conductance of a coarse edge = 4 * weighted mean (over the 3x3 transverse fine lines, weights
+// 1-2-1) of the series conductance of the two fine edges it spans; mass = trilinear-weighted sum (total weight 8)
+void coarsen(const MGLevel& f, MGLevel& c)
+{
+    const int n = f.n, nc = (n + 1)/2, nnc = nc*nc, nn = n*n;
+    c.n = nc;
+    const size_t sz = (size_t)nc*nnc;
+    c.gx.assign(sz, 1.0); c.gy.assign(sz, 1.0); c.gz.assign(sz, 1.0); c.m.assign(sz, 0.0);
+    c.e.assign(sz, 0.0); c.b.assign(sz, 0.0);
+    static const double w3[3] = {0.25, 0.5, 0.25};
+
+    for (int zc = 1; zc < nc-1; zc++)
+        for (int yc = 1; yc < nc-1; yc++)
+            for (int xc = 1; xc < nc-1; xc++)
+            {
+                const size_t pc = ((size_t)zc*nc + yc)*nc + xc;
+                const size_t pf = ((size_t)(2*zc)*n + 2*yc)*n + 2*xc;
+                double ms = 0.0;
+                for (int dz = -1; dz <= 1; dz++)
+                    for (int dy = -1; dy <= 1; dy++)
+                        for (int dx = -1; dx <= 1; dx++)
+                        {
+                            const double w = ((dx == 0) ? 1.0 : 0.5) * ((dy == 0) ? 1.0 : 0.5) * ((dz == 0) ? 1.0 : 0.5);
+                            ms += w * f.m[pf + (long)dz*nn + (long)dy*n + dx];
+                        }
+                c.m[pc] = ms;
+            }
+
+    // x edges (xc .. xc+1) for interior yc,zc ; y edges for interior xc,zc ; z edges for interior xc,yc
+    for (int zc = 1; zc < nc-1; zc++)
+        for (int yc = 1; yc < nc-1; yc++)
+            for (int xc = 0; xc < nc-1; xc++)
+            {
+                const size_t pc = ((size_t)zc*nc + yc)*nc + xc;
+                const size_t pf = ((size_t)(2*zc)*n + 2*yc)*n + 2*xc;
+                double s = 0.0;
+                for (int dz = -1; dz <= 1; dz++)
+                    for (int dy = -1; dy <= 1; dy++)
+                    {
+                        const size_t q = pf + (long)dz*nn + (long)dy*n;
+                        const double g1 = f.gx[q], g2 = f.gx[q+1];
+                        s += w3[dz+1]*w3[dy+1] * (g1*g2/(g1+g2));
+                    }
+                c.gx[pc] = 4.0*s;
+            }
+    for (int zc = 1; zc < nc-1; zc++)
+        for (int yc = 0; yc < nc-1; yc++)
+            for (int xc = 1; xc < nc-1; xc++)
+            {
+                const size_t pc = ((size_t)zc*nc + yc)*nc + xc;
+                const size_t pf = ((size_t)(2*zc)*n + 2*yc)*n + 2*xc;
+                double s = 0.0;
+                for (int dz = -1; dz <= 1; dz++)
+                    for (int dx = -1; dx <= 1; dx++)
+                    {
+                        const size_t q = pf + (long)dz*nn + dx;
+                        const double g1 = f.gy[q], g2 = f.gy[q+n];
+                        s += w3[dz+1]*w3[dx+1] * (g1*g2/(g1+g2));
+                    }
+                c.gy[pc] = 4.0*s;
+            }
+    for (int zc = 0; zc < nc-1; zc++)
+        for (int yc = 1; yc < nc-1; yc++)
+            for (int xc = 1; xc < nc-1; xc++)
+            {
+                const size_t pc = ((size_t)zc*nc + yc)*nc + xc;
+                const size_t pf = ((size_t)(2*zc)*n + 2*yc)*n + 2*xc;
+                double s = 0.0;
+                for (int dy = -1; dy <= 1; dy++)
+                    for (int dx = -1; dx <= 1; dx++)
+                    {
+                        const size_t q = pf + (long)dy*n + dx;
+                        const double g1 = f.gz[q], g2 = f.gz[q+nn];
+                        s += w3[dy+1]*w3[dx+1] * (g1*g2/(g1+g2));
+                    }
+                c.gz[pc] = 4.0*s;
+            }
+    build_kd(c);
+}
+
+// b_coarse(C) = sum_o w(o) r(2C+o)   (transpose of trilinear prolongation)
+void restrictTo(const vector<double>& rf, int n, MGLevel& c)
+{
+    const int nc = c.n, nn = n*n;
+    for (int zc = 1; zc < nc-1; zc++)
+        for (int yc = 1; yc < nc-1; yc++)
+            for (int xc = 1; xc < nc-1; xc++)
+            {
+                const size_t pf = ((size_t)(2*zc)*n + 2*yc)*n + 2*xc;
+                double s = 0.0;
+                for (int dz = -1; dz <= 1; dz++)
+                    for (int dy = -1; dy <= 1; dy++)
+                        for (int dx = -1; dx <= 1; dx++)
+                        {
+                            const double w = ((dx == 0) ? 1.0 : 0.5) * ((dy == 0) ? 1.0 : 0.5) * ((dz == 0) ? 1.0 : 0.5);
+                            s += w * rf[pf + (long)dz*nn + (long)dy*n + dx];
+                        }
+                c.b[((size_t)zc*nc + yc)*nc + xc] = s;
+            }
+}
+
+// fine += P e_coarse
+void prolongAdd(const MGLevel& c, vector<double>& fine, int n)
+{
+    const int nc = c.n, nn = n*n;
+    for (int zc = 1; zc < nc-1; zc++)
+        for (int yc = 1; yc < nc-1; yc++)
+            for (int xc = 1; xc < nc-1; xc++)
+            {
+                const double ev = c.e[((size_t)zc*nc + yc)*nc + xc];
+                if (ev == 0.0) continue;
+                const size_t pf = ((size_t)(2*zc)*n + 2*yc)*n + 2*xc;
+                for (int dz = -1; dz <= 1; dz++)
+                    for (int dy = -1; dy <= 1; dy++)
+                        for (int dx = -1; dx <= 1; dx++)
+                        {
+                            const double w = ((dx == 0) ? 1.0 : 0.5) * ((dy == 0) ? 1.0 : 0.5) * ((dz == 0) ? 1.0 : 0.5);
+                            fine[pf + (long)dz*nn + (long)dy*n + dx] += w*ev;
+                        }
+            }
+}
+
+void vcycle(vector<MGLevel>& lv, int l, vector<double>& scratch, int nu1, int nu2)
+{
+    MGLevel& L = lv[l];
+    if (l == (int)lv.size()-1)
+    {
+        for (int s = 0; s < 40; s++) sweepCoarse(L);
+        return;
+    }
+    for (int s = 0; s < nu1; s++) sweepCoarse(L);
+    residualCoarse(L, scratch);
+    MGLevel& C = lv[l+1];
+    C.e.assign(C.e.size(), 0.0);
+    restrictTo(scratch, L.n, C);
+    vcycle(lv, l+1, scratch, nu1, nu2);
+    prolongAdd(C, L.e, L.n);
+    for (int s = 0; s < nu2; s++) sweepCoarse(L);
+}
+
+} // namespace
+
+
+bool CDelphiFastSOR::mgSolve()
+{
+    static int disabled = -1, allGrids = -1;
+    if (disabled < 0) { disabled = (getenv("PKA_MG") == NULL || getenv("PKA_NO_MG") != NULL) ? 1 : 0; allGrids = (getenv("PKA_MG_ALL") != NULL) ? 1 : 0; }
